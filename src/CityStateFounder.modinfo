<?xml version="1.0" encoding="utf-8"?>
<Mod id="DE55664B-313E-451F-9488-23F168359B9D" version="1.0.0">
  <Properties>
    <Name>LOC_CSF_MOD_NAME</Name>
    <Description>LOC_CSF_MOD_DESCRIPTION</Description>
    <Teaser>LOC_CSF_MOD_TEASER</Teaser>
    <Authors>Jianbao</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>

  <!-- ⚠️⚠️ 必须有这个块！
       Properties 里的 Name / Description / Teaser 引用的是 LOC 键，而
       **游戏内「额外内容 / MOD 配置」面板读的是 modinfo 自带的 <LocalizedText>**
       —— 它在【扫描 mod 时】就要能解析，比任何 FrontEndActions 都早。
       缺了它，面板上会直接显示 LOC_CSF_MOD_NAME 这样的原始键。
       （对照：ODA / JIANBAO / FlandreEmpire 的 modinfo 都有这个块；
         CCB 系列的 <Name> 直接写明文，所以它们不需要。） -->
  <LocalizedText>
    <Text id="LOC_CSF_MOD_NAME">
      <en_US>City-State Founder</en_US>
      <zh_Hans_CN>城邦缔造者</zh_Hans_CN>
    </Text>
    <Text id="LOC_CSF_MOD_TEASER">
      <en_US>Let the player place City-States on the map.</en_US>
      <zh_Hans_CN>让玩家亲手把城邦放上地图。</zh_Hans_CN>
    </Text>
    <Text id="LOC_CSF_MOD_DESCRIPTION">
      <en_US>Adds the City-State Envoy unit, which cannot found a normal city but instead founds a City-State. A panel lists the City-States available in this game (icon / name / suzerain bonus) for you to choose from.</en_US>
      <zh_Hans_CN>新增「建邦使节」单位：它不能建立普通城市，而是建立一个城邦。配套面板会列出本局可用的城邦（图标 / 名称 / 宗主加成）供你选择。</zh_Hans_CN>
    </Text>
  </LocalizedText>

  <ActionCriteria>
    <Criteria id="CSF_XP2">
      <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
    </Criteria>
  </ActionCriteria>

  <FrontEndActions>
    <UpdateText id="CSF_Text_FE">
      <File>Text/CSF_Text.xml</File>
    </UpdateText>
    <!-- ⚠️ 必须用【直接 File 子元素】，不能包在 Items 里（T-148）。
         Items 是 ImportFiles / AddUserInterfaces 那类动作的写法；
         知识库 knowledge/modinfo/action-patterns.md 的示例也是直接 File。
         注：本条注释刻意不写尖括号标签，否则会被静态审计器的正则误当成真实引用。

         ⚠️⚠️ 但即使写法正确，本机实测这个动作【仍然不执行】——
            · 把 DUEL 的 MaxCityStates 设成 999，活库里依然是 6（无论放
              FrontEndActions 还是 InGameActions，也无论有没有 SELECT 1;）
            · Database.log 里该文件零出现，反而出现
                [Configuration] ERROR: database schema is locked: main
                [Configuration] ERROR: Failed to Backup Database.
              → **本机的配置库处于异常状态，模组对配置库的写入静默失败**
              （旁证：BBM 新增的 ExtraStandardMapSizes 域确实出现在活库里，
                说明机制本身是通的，只是本机环境有问题）
         所以 CSF_MapSizes.sql 目前保持【不修改任何值】，避免留下"以为改了其实没改"的假象。
         真要放开提高城邦数量，请先确认配置库恢复正常（见该 sql 文件里的步骤）。 -->
    <UpdateDatabase id="CSF_MapSizes">
      <File>Data/CSF_MapSizes.sql</File>
    </UpdateDatabase>
    <!-- ⭐ 单位图标（复用开拓者的图）—— 照官方 Australia.modinfo:36 的写法 -->
    <UpdateIcons id="CSF_Icons_FE">
      <File>Data/CSF_Icons.xml</File>
    </UpdateIcons>
  </FrontEndActions>

  <InGameActions>
    <UpdateDatabase id="CSF_Units" criteria="CSF_XP2">
      <File>Data/CSF_Units.sql</File>
    </UpdateDatabase>

    <UpdateText id="CSF_Text_IG" criteria="CSF_XP2">
      <File>Text/CSF_Text.xml</File>
    </UpdateText>

    <!-- ⭐ 单位图标（复用开拓者的图）—— 必须同时注册在 InGame，
         否则游戏内建造列表 / 单位面板 / 地图旗帜都取不到图标 -->
    <UpdateIcons id="CSF_Icons_IG" criteria="CSF_XP2">
      <File>Data/CSF_Icons.xml</File>
    </UpdateIcons>

    <AddGameplayScripts id="CSF_Gameplay">
      <File>Lua/CSF_Gameplay.lua</File>
    </AddGameplayScripts>

    <ImportFiles id="CSF_UI_IMPORT">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <Items>
        <File>UI/CSF_Panel.xml</File>
        <File>UI/CSF_Panel.lua</File>
      </Items>
    </ImportFiles>
    <AddUserInterfaces id="CSF_UI">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>1001</LoadOrder>
      </Properties>
      <Items>
        <File>UI/CSF_Panel.xml</File>
      </Items>
    </AddUserInterfaces>

    <ImportFiles id="CSF_UNITPANEL_IMPORT">
      <Properties>
        <LoadOrder>1002</LoadOrder>
      </Properties>
      <Items>
        <File>UI/CSF_UnitPanel.lua</File>
      </Items>
    </ImportFiles>
    <ReplaceUIScript id="CSF_REPLACE_UNITPANEL">
      <Properties>
        <LoadOrder>500000</LoadOrder>
        <LuaContext>UnitPanel</LuaContext>
        <LuaReplace>UI/CSF_UnitPanel.lua</LuaReplace>
      </Properties>
    </ReplaceUIScript>
  </InGameActions>

  <Files>
    <File>Data/CSF_Icons.xml</File>
    <File>Data/CSF_MapSizes.sql</File>
    <!-- Data/CSF_MapSizes.xml 是【可选】的"提高城邦数量上限"方案（默认不启用）。
         要启用：在 FrontEndActions 里加一条 UpdateDatabase 指向它，
         并把上面那条指向 CSF_MapSizes.sql 的去掉。
         为什么不默认启用：它会把开局设置里城邦数量滑条的上限抬高，
         属于改变玩家可选范围的改动，应由玩家自己决定；
         而且和 CCB Maps 同用时需要先实测地图容量（详见该文件内的说明）。 -->
    <File>Data/CSF_MapSizes.xml</File>
    <File>Data/CSF_Units.sql</File>
    <File>Lua/CSF_Gameplay.lua</File>
    <File>UI/CSF_Panel.xml</File>
    <File>UI/CSF_Panel.lua</File>
    <File>UI/CSF_UnitPanel.lua</File>
    <File>Text/CSF_Text.xml</File>
  </Files>
</Mod>
