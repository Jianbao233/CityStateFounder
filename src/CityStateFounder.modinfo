<?xml version="1.0" encoding="utf-8"?>
<Mod id="DE55664B-313E-451F-9488-23F168359B9D" version="1.0.2">
  <Properties>
    <Name>LOC_CSF_MOD_NAME</Name>
    <Description>LOC_CSF_MOD_DESCRIPTION</Description>
    <Teaser>LOC_CSF_MOD_TEASER</Teaser>
    <Authors>Jianbao</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>

  <!-- ⚠️⚠️ 必须有这个块！
       Properties 里的 Name / Description / Teaser 引用的是 LOC 键，而
       **游戏内「额外内容 / MOD 配置」面板读的是 modinfo 自带的 <LocalizedText>**
       —— 它在【扫描 mod 时】就要能解析，比任何 FrontEndActions 都早。
       缺了它，面板上会直接显示 LOC_CSF_MOD_NAME 这样的原始键。
       （对照：ODA / JIANBAO / FlandreEmpire 的 modinfo 都有这个块；
         CCB 系列的 <Name> 直接写明文，所以它们不需要。） -->
  <LocalizedText>
    <Text id="LOC_CSF_MOD_NAME">
      <en_US>City-State Founder v1.0.2</en_US>
      <zh_Hans_CN>城邦缔造者 v1.0.2</zh_Hans_CN>
    </Text>
    <Text id="LOC_CSF_MOD_TEASER">
      <en_US>Found City-States wherever you want.</en_US>
      <zh_Hans_CN>随心所欲建建邦</zh_Hans_CN>
    </Text>
    <Text id="LOC_CSF_MOD_DESCRIPTION">
      <en_US>Adds the City-State Envoy unit. It cannot found a normal city - instead it summons a City-State that is not yet present on the map, right where it stands. A panel lists the City-States available in this game (icon / name / suzerain bonus) for you to choose from.</en_US>
      <zh_Hans_CN>新增「建邦使节」单位：不可建立普通城市，使用后原地召唤一个场上不存在的城邦。配套面板会列出本局可用的城邦（图标 / 名称 / 宗主加成）供你选择。</zh_Hans_CN>
    </Text>
  </LocalizedText>

  <ActionCriteria>
    <Criteria id="CSF_XP2">
      <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
    </Criteria>
  </ActionCriteria>

  <FrontEndActions>
    <UpdateText id="CSF_Text_FE">
      <File>Text/CSF_Text.xml</File>
    </UpdateText>
    <!-- ⭐⭐ MapSizes：提高城邦数量上限（已实机验证 2026-09-27）
         三个必须同时满足的条件，缺一个就不生效（都是实测踩出来的）：
           ① 必须用 XML 的 Replace，SQL 的 UPDATE 对配置库【完全无效】
           ② 必须给【很高的 LoadOrder】—— 否则会被别的 mod 覆盖回原值。
              实测 BBM（3179425402）的 Configuration/Config.xml 里也有
              StandardMapSizes 的 Replace（官方原值），默认顺序下它在
              我们之后加载（序列 135/196 vs 我们 107/196），会把改动抹掉。
              加上 999999 后我们排到最后（196/196），改动才保住。
           ③ Replace 是【整行替换】，11 列必须给全，漏列会变 NULL。
         验证结果：活库里 StandardMapSizes 的上限确实变成
           决斗 10 / 极小 14 / 小 18 / 标准 22 / 大 26 / 巨大 28，
         而 DefaultCityStates 保持官方原值（3/6/9/12/15/18）不变
         —— 所以开局设置界面的布局与默认值完全不变，只是滑条能拉更高。
         详细说明与注意事项见 Data/CSF_MapSizes.xml 内的注释。
         注：本条注释刻意不写尖括号标签，否则会被静态审计器的正则误当成真实引用。 -->
    <!-- ⛔⛔⛔ 【2026-10-04 重大修复】这里原本指向 Data/CSF_MapSizes.xml —— 那是错的！
         后果（实测）：**游戏一启用本 mod 就 early exit，根本进不了对局。**
           日志：LoadGameViewState leaving the network session due to an
                 early exit of the game state.
           （排查过程：禁用本 mod → 能开局；启用 → 6 秒后 early exit。）

         根因：CSF_MapSizes.xml 把 MaxCityStates 抬到 9/15/21/27/33/36，
               而 CCB Maps 的出生点分配循环【没有边界保护】——
               出生点用完时 validspawnsleft[rng+1] 是 nil，索引它就崩：
                 BBM_AssignStartingPlots.lua:353: attempt to index a nil value
               地图生成失败 → 引擎 early exit。
               （该 XML 自己的文件头就写着"⛔ 本文件当前【未注册】—— 因为实测会崩"，
                 是 modinfo 这里被误改成了指向它。）

         ✅ 正确做法：指向 Data/CSF_MapSizes.sql —— 那个文件【不修改任何值】，
            只保留技术考证注释。想提高上限请走开局设置的【城邦数量滑条】，
            且不要超过地图容量。 -->
    <UpdateDatabase id="CSF_MapSizes">
      <Properties>
        <LoadOrder>999999</LoadOrder>
      </Properties>
      <File>Data/CSF_MapSizes.sql</File>
    </UpdateDatabase>
    <!-- ⚠️ 这里原本还挂了一条 CSF_CityStateCountRange，把滑条的【显示】上限映射回
         官方 X（标准图 18）—— 已【移除】。
         原因：滑条值和引擎创建数是【同一个值】，压住滑条就一起压住了引擎。
         想做到"滑条显示 18 / 引擎创建 27"必须拦参数写入，而参数值在拖动那一刻
         就落库、且游戏会缓存上次设置 → 任何钩子都可能不触发（详见 InGameActions
         里的说明）。所以 A 方案就是【让滑条直接能拉到 X + X/2，玩家自己拉满】。 -->
    <!-- ⭐ 单位图标（复用开拓者的图）—— 照官方 Australia.modinfo:36 的写法 -->
    <UpdateIcons id="CSF_Icons_FE">
      <File>Data/CSF_Icons.xml</File>
    </UpdateIcons>

    <!-- ⭐ 城邦"官方级"数据（2026-10-04）—— 以下全是【配置库】，必须挂 FrontEndActions
         参考工坊 3591345334「Modder群友城邦小合集」的 Picker.sql / Colors.sql / Config.xml
         缺这三样 → 城邦面板显示 unknownType、加成文案空白、旗标没颜色。
         注：本条注释刻意不写尖括号标签，否则会被静态审计器的正则误当成真实引用。 -->
    <UpdateDatabase id="CSF_CityStateConfig">
      <Properties>
        <LoadOrder>100</LoadOrder>
      </Properties>
      <File>Data/CSF_CityStatePicker.sql</File>
      <File>Data/CSF_CityStateConfig.xml</File>
    </UpdateDatabase>
    <UpdateText id="CSF_CustomCityStates_Text_FE">
      <File>Text/CSF_CustomCityStates_Text.xml</File>
    </UpdateText>
  </FrontEndActions>

  <InGameActions>
    <!-- ⚠️ 这里原本覆盖 UI/FrontEnd/GameSetupLogic.lua 来拦"滑条选 N、实际写 N+N/2"，
         已放弃并移除。原因（记下来免得再走）：
           · 参数值在【拖动滑条那一刻】就写进配置库了；游戏还会缓存上次的开局设置，
             重新打开设置时数量已经是原值 → SetParameterValue 根本不被调用
             → 任何钩子都不会跑，引擎按缓存值创建城邦。
           · 试过的三条路都因此失效：Parameters_Config_EndWrite（改内存不回写库）、
             GameParameters_PostProcess（同上）、包 SetupParameters:SetParameterValue
             （只在该参数真的被改变时才触发 —— 正是缓存命中时跳过的情形）。
         → 结论：滑条显示 18 / 实际 27 这一层做不到；改成
           【滑条直接能拉到 X + X/2，玩家自己拉满】，见 Data/CSF_MapSizes.xml。 -->
    <UpdateDatabase id="CSF_Units" criteria="CSF_XP2">
      <File>Data/CSF_Units.sql</File>
    </UpdateDatabase>

    <!-- ⭐⭐ 「能力重复、名字不同」的自定义城邦
         原理：城邦能力由 LeaderTraits 承载 —— 各城邦名字/领袖不同，
               但指向【同一个 Trait】→ 能力完全相同、名字各自独立。
         数据模型依据：实机数据库反查（docs/DLL版_调研设计与计划.md 附录 E）。
         SQL 由 tools/_gen_custom_cs.py 生成，加城邦改那个脚本即可。
         LoadOrder 取高值，确保晚于其它 mod 的城邦改动。 -->
    <!-- ⭐ 城邦"自我共存"登记（2026-10-04）：让【同一个城邦能被复制多份】
         DuplicateCivilizations 语义 = 两者可共存。官方 54 个城邦原本全都没有登记，
         复制它们会让引擎崩溃（实测：造副本后点下一回合，游戏原生崩溃）。
         本文件给每个城邦加一行 (X, X)。

         ⭐ 2026-10-04 更新：自制城邦已【重新上架】，并按官方级写法补全了
            TypeProperties / CityStates / PlayerColors / 选择器参数
            （参考工坊 3591345334「Modder群友城邦小合集」）。
            现在面板「类型」不再是 unknownType，旗标也有颜色。 -->
    <UpdateDatabase id="CSF_CustomCityStates" criteria="CSF_XP2">
      <Properties>
        <LoadOrder>2100000</LoadOrder>
      </Properties>
      <File>Data/CSF_CustomCityStates.sql</File>
    </UpdateDatabase>
    <!-- ⭐ 颜色（2026-10-04 修正）：PlayerColors 表在【玩法库】（DebugGameplay.sqlite），
         不是配置库！所以这条必须挂 InGameActions，不能用 FrontEndActions 的 UpdateColors。
         （实测：挂 FrontEndActions 时 PlayerColors 里 0 行 → 城邦没颜色） -->
    <UpdateDatabase id="CSF_CityStateColors" criteria="CSF_XP2">
      <Properties>
        <LoadOrder>2100002</LoadOrder>
      </Properties>
      <File>Data/CSF_CityStateColors.sql</File>
    </UpdateDatabase>
    <UpdateDatabase id="CSF_DuplicateCityStates" criteria="CSF_XP2">
      <Properties>
        <LoadOrder>2100001</LoadOrder>
      </Properties>
      <File>Data/CSF_DuplicateCityStates.sql</File>
    </UpdateDatabase>

    <UpdateText id="CSF_Text_IG" criteria="CSF_XP2">
      <File>Text/CSF_Text.xml</File>
    </UpdateText>

    <!-- ⭐ 单位图标（复用开拓者的图）—— 必须同时注册在 InGame，
         否则游戏内建造列表 / 单位面板 / 地图旗帜都取不到图标 -->
    <UpdateIcons id="CSF_Icons_IG" criteria="CSF_XP2">
      <File>Data/CSF_Icons.xml</File>
    </UpdateIcons>

    <AddGameplayScripts id="CSF_Gameplay">
      <File>Lua/CSF_Gameplay.lua</File>
    </AddGameplayScripts>

    <!-- ⭐ 实时创建城邦（2026-10-04 实测突破）
         三步公式：SetPlayerSlotStatus(slot,1) → InitializePlayer(slot) → GetCities():Create(x,y)
         让玩家把【池子里有、但未出现在玩家槽位】的城邦在对局中实时建到任意位置。
         原理与逆向依据见 docs/DLL实时激活城邦_逆向进展.md，以及该文件头部注释。 -->
    <AddGameplayScripts id="CSF_CreateCityState">
      <File>Lua/CSF_CreateCityState.lua</File>
    </AddGameplayScripts>

    <ImportFiles id="CSF_UI_IMPORT">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <Items>
        <File>UI/CSF_Panel.xml</File>
        <File>UI/CSF_Panel.lua</File>
      </Items>
    </ImportFiles>
    <AddUserInterfaces id="CSF_UI">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>1001</LoadOrder>
      </Properties>
      <Items>
        <File>UI/CSF_Panel.xml</File>
      </Items>
    </AddUserInterfaces>

    <ImportFiles id="CSF_UNITPANEL_IMPORT">
      <Properties>
        <LoadOrder>1002</LoadOrder>
      </Properties>
      <Items>
        <File>UI/CSF_UnitPanel.lua</File>
      </Items>
    </ImportFiles>

    <!-- ⛔⛔⛔ 2026-10-05：**UnitPanel 替换已【移除】**
         原因：CCB经典版 也替换 UnitPanel（`ui/replacements/unitpanel_bbg.lua`）。
               ReplaceUIScript 的胜负由【组件应用顺序】决定（后应用的赢），
               而本 mod 在经典版之后被应用 → 我们总是赢 → 【经典版 UnitPanel 功能失效】。
               组件内的 LoadOrder 改小【无效】（实测：BBG 先应用、我们后应用）。
         代价：建邦使节身上不再有「建立城邦」按钮。
         补偿：面板改用 **Ctrl+E 热键**打开（CSF_Panel.lua 自己的输入处理器，
               走 InGame 上下文，完全不碰 UnitPanel）→ 功能不丢、零冲突。
         相关文件 UI/CSF_UnitPanel.lua 保留在源码里（将来若并进经典版可用）。 -->
    <!-- 城邦旗标兜底（T-156）：修 CityBannerManager 的 SetColor(nil) 崩溃
         根因：中途建出来的城邦（副本）不在 UI 的颜色表里，UI.GetPlayerColors 返回 nil，
               旗标代码把 nil 传给 SetColor → 引擎原生崩溃。
         做法照 CCB MirrorMap 的 CityBannerManager_Mirror：加载原版后覆盖
               CityBanner:UpdateColor()，颜色为 nil 时用源城邦颜色 / 按文明取色兜底。
         同时给副本拼名字后缀（" II"）。
         注：本条注释刻意不写尖括号标签，否则会被静态审计器的正则误当成真实引用。 -->
    <ReplaceUIScript id="CSF_REPLACE_CITYBANNER">
      <Properties>
        <LoadOrder>500001</LoadOrder>
        <LuaContext>CityBannerManager</LuaContext>
        <LuaReplace>UI/CSF_CityBannerPatch.lua</LuaReplace>
      </Properties>
    </ReplaceUIScript>
    <ImportFiles id="CSF_BANNER_IMPORT">
      <Properties>
        <LoadOrder>1003</LoadOrder>
      </Properties>
      <Items>
        <File>UI/CSF_CityBannerPatch.lua</File>
      </Items>
    </ImportFiles>
      <!-- ⭐⭐ CCB Maps 崩溃修复补丁（T-155）
         覆盖 CCB Maps 的 Data/BBS Maps/Utility/BBM_AssignStartingPlots.lua。
         该文件【只有 CCB Maps / BBM 提供】，其他任何地图 mod 都不碰它，
         所以覆盖它不会与别的地图 mod 冲突。
         改动只有一处：给城邦出生点分配循环补上边界检查（原版没检查，
         出生点用完时会索引 nil 直接崩掉地图生成）。
         正常情况（数量在地图容量内）行为与原版完全一致。
         注：本条注释刻意不写尖括号标签，否则会被静态审计器的正则误当成真实引用。 -->
    <ImportFiles id="CSF_CCB_FIX_SPAWN">
      <Properties>
        <LoadOrder>3000000</LoadOrder>
      </Properties>
      <Items>
        <File>Data/BBS Maps/Utility/BBM_AssignStartingPlots.lua</File>
      </Items>
    </ImportFiles>
    <ImportFiles id="CSF_CCB_FIX_RIVER">
      <Properties>
        <LoadOrder>3000001</LoadOrder>
      </Properties>
      <Items>
        <File>Data/BBS Maps/Utility/BBM_CivilizationAssign.lua</File>
      </Items>
    </ImportFiles>
  </InGameActions>

  <Files>
    <File>Data/CSF_Icons.xml</File>
    <File>Data/CSF_MapSizes.sql</File>
    <!-- Data/CSF_MapSizes.xml 是【可选】的"提高城邦数量上限"方案（默认不启用）。
         要启用：在 FrontEndActions 里加一条 UpdateDatabase 指向它，
         并把上面那条指向 CSF_MapSizes.sql 的去掉。
         为什么不默认启用：它会把开局设置里城邦数量滑条的上限抬高，
         属于改变玩家可选范围的改动，应由玩家自己决定；
         而且和 CCB Maps 同用时需要先实测地图容量（详见该文件内的说明）。 -->
    <File>Data/CSF_MapSizes.xml</File>
    <File>Data/CSF_CityStateCountRange.xml</File>
    <!-- ⚠️ 被 ImportFiles 覆盖的文件【必须】同时列在这里，否则不进 VFS。
         实测踩到过：只在 ImportFiles 里列、漏了 <Files> 时钩子静默失效。 -->
    <File>Data/BBS Maps/Utility/BBM_AssignStartingPlots.lua</File>
    <File>Data/BBS Maps/Utility/BBM_CivilizationAssign.lua</File>
    <File>Data/CSF_Units.sql</File>
    <File>Data/CSF_DuplicateCityStates.sql</File>
    <File>Data/CSF_CustomCityStates.sql</File>
    <File>Data/CSF_CityStatePicker.sql</File>
    <File>Data/CSF_CityStateColors.sql</File>
    <File>Data/CSF_CityStateConfig.xml</File>
    <File>Text/CSF_CustomCityStates_Text.xml</File>
    <File>Lua/CSF_Gameplay.lua</File>
    <File>UI/CSF_Panel.xml</File>
    <File>UI/CSF_Panel.lua</File>
    <File>UI/CSF_UnitPanel.lua</File>
    <File>Text/CSF_Text.xml</File>
    <File>Lua/CSF_CreateCityState.lua</File>
    <File>UI/CSF_CopyRegistry.lua</File>
    <File>UI/CSF_CityBannerPatch.lua</File>
  </Files>
</Mod>